          "ordered": [
            "RFC_ResetMasterDeathChance(this)",
            "GS_ClearSituationSnap(this)",
            "GS_CaptureSituationSnap(this)",
            "RFC_ApplyDeathOverrideGates(this, c)",
            "wrappedMethod(evt)",
