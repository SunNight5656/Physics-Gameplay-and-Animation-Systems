    if Equals(name, n"forwardEnabled") { return target.forwardEnabled; };
    if Equals(name, n"forwardUseCached") { return target.forwardUseCached; };
    if Equals(name, n"forwardUseFacing") { return target.forwardUseFacing; };
    if Equals(name, n"impactEnabled") { return target.impactEnabled; };
    if Equals(name, n"impactForwardAlso") { return target.impactForwardAlso; };
    if Equals(name, n"impactForwardUseCached") { return target.impactForwardUseCached; };
    if Equals(name, n"impactForwardUseFacing") { return target.impactForwardUseFacing; };
    if Equals(name, n"impactUseRamp") { return target.impactUseRamp; };
    if Equals(name, n"momentumEnabled") { return target.momentumEnabled; };
    if Equals(name, n"useChance") { return target.useChance; };
    return false;
  }
