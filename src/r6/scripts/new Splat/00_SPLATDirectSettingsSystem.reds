  public func SetBool(scopeName: CName, groupName: CName, name: CName, value: Bool) -> Bool {
    if Equals(groupName, n"RFCModSettings") {
      // These four fields look like menu visibility controls, but the Trip
      // runtime also uses them to enable/disable the push-reaction popup.
      if Equals(name, n"customTripEmotion_showPushReactionPopup") { this.TargetRFC(scopeName).customTripEmotion_showPushReactionPopup = value; return true; };
      if Equals(name, n"realismPlusTripEmotion_showPushReactionPopup") { this.TargetRFC(scopeName).realismPlusTripEmotion_showPushReactionPopup = value; return true; };
      if Equals(name, n"dirtyTripEmotion_showPushReactionPopup") { this.TargetRFC(scopeName).dirtyTripEmotion_showPushReactionPopup = value; return true; };
      if Equals(name, n"arnoldTripEmotion_showPushReactionPopup") { this.TargetRFC(scopeName).arnoldTripEmotion_showPushReactionPopup = value; return true; };
      return this.SetScoped_RFC_Bool(scopeName, name, value);
    };
    if Equals(groupName, n"HIS_Settings") { return this.SetScoped_HIS_Bool(scopeName, name, value); };
    if Equals(groupName, n"GS_Settings") { return this.SetScoped_GS_Bool(scopeName, name, value); };
    if Equals(groupName, n"SHHJM_Settings") { return this.SetScoped_SHHJM_Bool(scopeName, name, value); };
    return false;
  }
  public func GetBool(scopeName: CName, groupName: CName, name: CName) -> Bool {
    if Equals(groupName, n"RFCModSettings") {
      if Equals(name, n"customTripEmotion_showPushReactionPopup") { return this.TargetRFC(scopeName).customTripEmotion_showPushReactionPopup; };
      if Equals(name, n"realismPlusTripEmotion_showPushReactionPopup") { return this.TargetRFC(scopeName).realismPlusTripEmotion_showPushReactionPopup; };
      if Equals(name, n"dirtyTripEmotion_showPushReactionPopup") { return this.TargetRFC(scopeName).dirtyTripEmotion_showPushReactionPopup; };
      if Equals(name, n"arnoldTripEmotion_showPushReactionPopup") { return this.TargetRFC(scopeName).arnoldTripEmotion_showPushReactionPopup; };
      return this.GetScoped_RFC_Bool(scopeName, name);
    };
    if Equals(groupName, n"HIS_Settings") { return this.GetScoped_HIS_Bool(scopeName, name); };
    if Equals(groupName, n"GS_Settings") { return this.GetScoped_GS_Bool(scopeName, name); };
    if Equals(groupName, n"SHHJM_Settings") { return this.GetScoped_SHHJM_Bool(scopeName, name); };
    return false;
  }

  public func SetFloat(scopeName: CName, groupName: CName, name: CName, value: Float) -> Bool {
    if Equals(groupName, n"RFCModSettings") { return this.SetScoped_RFC_Float(scopeName, name, value); };
    if Equals(groupName, n"HIS_Settings") { return this.SetScoped_HIS_Float(scopeName, name, value); };
    if Equals(groupName, n"GS_Settings") { return this.SetScoped_GS_Float(scopeName, name, value); };
    if Equals(groupName, n"SHHJM_Settings") { return this.SetScoped_SHHJM_Float(scopeName, name, value); };
    return false;
  }
