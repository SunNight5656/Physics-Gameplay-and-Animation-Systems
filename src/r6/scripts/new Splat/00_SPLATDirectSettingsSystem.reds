    if Equals(name, n"earlyDropEnabled") { return true; };
    if Equals(name, n"earlyDropForwardEnabled") { return true; };
    if Equals(name, n"earlyDropForwardUseCached") { return true; };
    if Equals(name, n"earlyDropForwardUseFacing") { return true; };
    if Equals(name, n"earlyDropUseRamp") { return true; };
    if Equals(name, n"enabled") { return true; };
