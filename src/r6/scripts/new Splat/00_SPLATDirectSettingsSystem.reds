  }

  private func Set_GS_Float_0(target: ref<GS_Settings>, name: CName, value: Float) -> Bool {
    if Equals(name, n"forwardStrengthPctMin") { target.forwardStrengthPctMin = value; return true; };
    if Equals(name, n"earlyDropForwardStrengthPctMin") { target.earlyDropForwardStrengthPctMin = value; return true; };
    if Equals(name, n"earlyDropStrengthPctMin") { target.earlyDropStrengthPctMin = value; return true; };
    if Equals(name, n"impactForwardStrengthPctMin") { target.impactForwardStrengthPctMin = value; return true; };
    if Equals(name, n"impactStrengthPctMin") { target.impactStrengthPctMin = value; return true; };

    if Equals(name, n"chancePct") { target.chancePct = value; return true; };
    if Equals(name, n"earlyDropDelaySec") { target.earlyDropDelaySec = value; return true; };
    if Equals(name, n"earlyDropForwardChancePct") { target.earlyDropForwardChancePct = value; return true; };
    if Equals(name, n"earlyDropForwardRadiusM") { target.earlyDropForwardRadiusM = value; return true; };
    if Equals(name, n"earlyDropForwardStrengthPct") { target.earlyDropForwardStrengthPct = value; return true; };
    if Equals(name, n"earlyDropRadiusM") { target.earlyDropRadiusM = value; return true; };
    if Equals(name, n"earlyDropRampSec") { target.earlyDropRampSec = value; return true; };
    if Equals(name, n"earlyDropStrengthPct") { target.earlyDropStrengthPct = value; return true; };
    if Equals(name, n"forwardChancePct") { target.forwardChancePct = value; return true; };
    if Equals(name, n"forwardDelaySec") { target.forwardDelaySec = value; return true; };
