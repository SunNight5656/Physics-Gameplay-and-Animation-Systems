  private func SetScoped_RFC_Bool(scopeName: CName, name: CName, value: Bool) -> Bool {
    let target: ref<RFCModSettings>;
    this.Ensure();
    // The motorcycle controls deliberately appear in both Global and Arnold.
    // Either UI location edits one shared value and mirrors it into every mode.
    if Equals(name, n"arnold_vehicleMotorcycleToppleOnBullet")
      || Equals(name, n"arnold_playerMotorcycleLeanToppleEnabled") {
      this.Set_RFC_Bool_0(this.m_global_menu, name, value);
      this.Set_RFC_Bool_0(this.m_realismCustom_menu, name, value);
      this.Set_RFC_Bool_0(this.m_realismPlus_menu, name, value);
      this.Set_RFC_Bool_0(this.m_dirtyHarry_menu, name, value);
      this.Set_RFC_Bool_0(this.m_arnoldArcade_menu, name, value);
      return true;
    };
    if Equals(scopeName, n"global") {
      if this.Has_RFC_Bool_0(name) {
        this.Set_RFC_Bool_0(this.m_global_menu, name, value);
        this.Set_RFC_Bool_0(this.m_realismCustom_menu, name, value);
        this.Set_RFC_Bool_0(this.m_realismPlus_menu, name, value);
        this.Set_RFC_Bool_0(this.m_dirtyHarry_menu, name, value);
        this.Set_RFC_Bool_0(this.m_arnoldArcade_menu, name, value);
        return true;
      };
      if this.Has_RFC_Bool_1(name) {
        this.Set_RFC_Bool_1(this.m_global_menu, name, value);
        this.Set_RFC_Bool_1(this.m_realismCustom_menu, name, value);
        this.Set_RFC_Bool_1(this.m_realismPlus_menu, name, value);
        this.Set_RFC_Bool_1(this.m_dirtyHarry_menu, name, value);
        this.Set_RFC_Bool_1(this.m_arnoldArcade_menu, name, value);
        return true;
      };
      if this.Has_RFC_Bool_2(name) {
        this.Set_RFC_Bool_2(this.m_global_menu, name, value);
        this.Set_RFC_Bool_2(this.m_realismCustom_menu, name, value);
        this.Set_RFC_Bool_2(this.m_realismPlus_menu, name, value);
        this.Set_RFC_Bool_2(this.m_dirtyHarry_menu, name, value);
        this.Set_RFC_Bool_2(this.m_arnoldArcade_menu, name, value);
        return true;
      };
      if this.Has_RFC_Bool_3(name) {
        this.Set_RFC_Bool_3(this.m_global_menu, name, value);
        this.Set_RFC_Bool_3(this.m_realismCustom_menu, name, value);
        this.Set_RFC_Bool_3(this.m_realismPlus_menu, name, value);
        this.Set_RFC_Bool_3(this.m_dirtyHarry_menu, name, value);
        this.Set_RFC_Bool_3(this.m_arnoldArcade_menu, name, value);
        return true;
      };
      return false;
    };
    target = this.TargetRFC(scopeName);
    if this.Set_RFC_Bool_0(target, name, value) { return true; };
    if this.Set_RFC_Bool_1(target, name, value) { return true; };
    if this.Set_RFC_Bool_2(target, name, value) { return true; };
    if this.Set_RFC_Bool_3(target, name, value) { return true; };
    return false;
  }
  private func GetScoped_RFC_Bool(scopeName: CName, name: CName) -> Bool {
    if Equals(name, n"arnold_vehicleMotorcycleToppleOnBullet")
      || Equals(name, n"arnold_playerMotorcycleLeanToppleEnabled") {
      return this.Get_RFC_Bool_0(this.m_global_menu, name);
