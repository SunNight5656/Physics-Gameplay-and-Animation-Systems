public class SPLATSettingsRuntime {
  public static func State() -> ref<SPLATSettingsState> {
    let player: ref<PlayerPuppet> = GetPlayer(GetGameInstance());
    if IsDefined(player) {
      return player.SPLATGetSettingsState();
    };
    return null;
  }

  public static func Menu() -> ref<RFCModSettings> {
    let state: ref<SPLATSettingsState> = SPLATSettingsRuntime.State();
    if IsDefined(state) { return state.Menu(); };
    return new RFCModSettings();
  }

  public static func Head() -> ref<HIS_Settings> {
    let state: ref<SPLATSettingsState> = SPLATSettingsRuntime.State();
    if IsDefined(state) { return state.Head(); };
    return new HIS_Settings();
  }

  public static func Body() -> ref<GS_Settings> {
    let state: ref<SPLATSettingsState> = SPLATSettingsRuntime.State();
    if IsDefined(state) { return state.Body(); };
    return new GS_Settings();
  }

  public static func Jolts() -> ref<SHHJM_Settings> {
    let state: ref<SPLATSettingsState> = SPLATSettingsRuntime.State();
    if IsDefined(state) { return state.Jolts(); };
    return new SHHJM_Settings();
  }
}
