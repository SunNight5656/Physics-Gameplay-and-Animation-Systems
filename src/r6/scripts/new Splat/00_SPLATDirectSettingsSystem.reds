    if Equals(groupName, n"HIS_Settings") { return this.GetScoped_HIS_Int(scopeName, name); };
    if Equals(groupName, n"GS_Settings") { return this.GetScoped_GS_Int(scopeName, name); };
    return 0;
  }

  public func SetMode(index: Int32) -> Bool {
    this.Ensure();
    if index == 1 { this.m_global_menu.splatPresetMode = RFCSplatPresetMode.Realism; return true; };
    if index == 2 { this.m_global_menu.splatPresetMode = RFCSplatPresetMode.RealismPlus; return true; };
    if index == 3 { this.m_global_menu.splatPresetMode = RFCSplatPresetMode.DirtyHarry; return true; };
    if index == 4 { this.m_global_menu.splatPresetMode = RFCSplatPresetMode.Arnold; return true; };
    if index == 5 { this.m_global_menu.splatPresetMode = RFCSplatPresetMode.Vanilla; return true; };
    return false;
  }
  public func GetMode() -> Int32 {
    let value: Int32;
    this.Ensure();
    value = EnumInt(this.m_global_menu.splatPresetMode);
    if value == EnumInt(RFCSplatPresetMode.RealismPlus) { return 2; };
    if value == EnumInt(RFCSplatPresetMode.DirtyHarry) { return 3; };
    if value == EnumInt(RFCSplatPresetMode.Arnold) { return 4; };
    if value == EnumInt(RFCSplatPresetMode.Vanilla) { return 5; };
    return 1;
  }

  // Runs entirely in REDscript against the live state. It temporarily changes
  // six representative values, verifies the exact runtime accessors/config
  // builder, then restores every value and the runtime-read counter.
  public func RunBridgeSelfTest() -> Int32 {
    let result: Int32 = 0;
    let oldMode: Int32;
    let oldReads: Int32;
    let oldGlobal: Float;
    let oldArcade: Float;
    let oldHead: Float;
    let oldBody: Float;
    let oldJolt: Float;
    let cfg: RFCConfig;
    let head: ref<HIS_Settings>;
    let body: ref<GS_Settings>;
    let jolts: ref<SHHJM_Settings>;

    this.Ensure();
    oldMode = this.GetMode();
    oldReads = this.m_runtimeReadCount;
    oldGlobal = this.GetFloat(n"global", n"RFCModSettings", n"masterDeathChancePct");
    oldArcade = this.GetFloat(n"arnoldArcade", n"RFCModSettings", n"arnold_arcadeBulletStrength");
    oldHead = this.GetFloat(n"arnoldArcade", n"HIS_Settings", n"forwardBackMin");
    oldBody = this.GetFloat(n"arnoldArcade", n"GS_Settings", n"forwardStrengthPct");
    oldJolt = this.GetFloat(n"arnoldArcade", n"SHHJM_Settings", n"headForwardStrength");

    this.SetFloat(n"global", n"RFCModSettings", n"masterDeathChancePct", 83.0);
    this.SetFloat(n"arnoldArcade", n"RFCModSettings", n"arnold_arcadeBulletStrength", 37.25);
    this.SetFloat(n"arnoldArcade", n"HIS_Settings", n"forwardBackMin", 6.25);
    this.SetFloat(n"arnoldArcade", n"GS_Settings", n"forwardStrengthPct", 77.0);
    this.SetFloat(n"arnoldArcade", n"SHHJM_Settings", n"headForwardStrength", 44.0);
    this.SetMode(4);

    if this.GetMode() == 4 { result = result + 1; };
    cfg = RFC.Cfg();
    if AbsF(cfg.arcadeBulletStrength - 37.25) < 0.001 { result = result + 2; };
    if AbsF(cfg.masterDeathChance - 0.83) < 0.001 { result = result + 4; };
    head = SPLATSettingsRuntime.Head();
    if IsDefined(head) && AbsF(head.forwardBackMin - 6.25) < 0.001 { result = result + 8; };
    body = SPLATSettingsRuntime.Body();
    if IsDefined(body) && AbsF(body.forwardStrengthPct - 77.0) < 0.001 { result = result + 16; };
    jolts = SPLATSettingsRuntime.Jolts();
    if IsDefined(jolts) && AbsF(jolts.headForwardStrength - 44.0) < 0.001 { result = result + 32; };

    this.SetFloat(n"global", n"RFCModSettings", n"masterDeathChancePct", oldGlobal);
    this.SetFloat(n"arnoldArcade", n"RFCModSettings", n"arnold_arcadeBulletStrength", oldArcade);
    this.SetFloat(n"arnoldArcade", n"HIS_Settings", n"forwardBackMin", oldHead);
    this.SetFloat(n"arnoldArcade", n"GS_Settings", n"forwardStrengthPct", oldBody);
    this.SetFloat(n"arnoldArcade", n"SHHJM_Settings", n"headForwardStrength", oldJolt);
    this.SetMode(oldMode);
    this.m_runtimeReadCount = oldReads;
    return result;
  }
}


@addField(PlayerPuppet)
private let splatSettingsState: ref<SPLATSettingsState>;

@addMethod(PlayerPuppet)
public func SPLATGetSettingsState() -> ref<SPLATSettingsState> {
  if !IsDefined(this.splatSettingsState) {
    this.splatSettingsState = new SPLATSettingsState();
  };
  return this.splatSettingsState;
}

