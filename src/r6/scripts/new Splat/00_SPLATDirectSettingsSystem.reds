module RealisticPush
// SPLAT V132 audited direct Native Settings bridge.
// The live PlayerPuppet owns the settings state. CET and gameplay therefore
// read and write the exact same objects; Mod Settings is not involved.
public class SPLATSettingsState {
  private let m_runtimeReadCount: Int32;
  private let m_sessionToken: Int32;
  private let m_global_menu: ref<RFCModSettings>;
  private let m_global_head: ref<HIS_Settings>;
  private let m_global_body: ref<GS_Settings>;
  private let m_global_jolts: ref<SHHJM_Settings>;
  private let m_realismCustom_menu: ref<RFCModSettings>;
  private let m_realismCustom_head: ref<HIS_Settings>;
  private let m_realismCustom_body: ref<GS_Settings>;
  private let m_realismCustom_jolts: ref<SHHJM_Settings>;
  private let m_realismPlus_menu: ref<RFCModSettings>;
  private let m_realismPlus_head: ref<HIS_Settings>;
  private let m_realismPlus_body: ref<GS_Settings>;
  private let m_realismPlus_jolts: ref<SHHJM_Settings>;
  private let m_dirtyHarry_menu: ref<RFCModSettings>;
  private let m_dirtyHarry_head: ref<HIS_Settings>;
  private let m_dirtyHarry_body: ref<GS_Settings>;
  private let m_dirtyHarry_jolts: ref<SHHJM_Settings>;
  private let m_arnoldArcade_menu: ref<RFCModSettings>;
  private let m_arnoldArcade_head: ref<HIS_Settings>;
  private let m_arnoldArcade_body: ref<GS_Settings>;
  private let m_arnoldArcade_jolts: ref<SHHJM_Settings>;

  private func Ensure() -> Void {
    if !IsDefined(this.m_global_menu) { this.m_global_menu = new RFCModSettings(); };
    if !IsDefined(this.m_global_head) { this.m_global_head = new HIS_Settings(); };
    if !IsDefined(this.m_global_body) { this.m_global_body = new GS_Settings(); };
    if !IsDefined(this.m_global_jolts) { this.m_global_jolts = new SHHJM_Settings(); };
    if !IsDefined(this.m_realismCustom_menu) { this.m_realismCustom_menu = new RFCModSettings(); };
    if !IsDefined(this.m_realismCustom_head) { this.m_realismCustom_head = new HIS_Settings(); };
    if !IsDefined(this.m_realismCustom_body) { this.m_realismCustom_body = new GS_Settings(); };
    if !IsDefined(this.m_realismCustom_jolts) { this.m_realismCustom_jolts = new SHHJM_Settings(); };
    if !IsDefined(this.m_realismPlus_menu) { this.m_realismPlus_menu = new RFCModSettings(); };
    if !IsDefined(this.m_realismPlus_head) { this.m_realismPlus_head = new HIS_Settings(); };
    if !IsDefined(this.m_realismPlus_body) { this.m_realismPlus_body = new GS_Settings(); };
    if !IsDefined(this.m_realismPlus_jolts) { this.m_realismPlus_jolts = new SHHJM_Settings(); };
    if !IsDefined(this.m_dirtyHarry_menu) { this.m_dirtyHarry_menu = new RFCModSettings(); };
    if !IsDefined(this.m_dirtyHarry_head) { this.m_dirtyHarry_head = new HIS_Settings(); };
    if !IsDefined(this.m_dirtyHarry_body) { this.m_dirtyHarry_body = new GS_Settings(); };
    if !IsDefined(this.m_dirtyHarry_jolts) { this.m_dirtyHarry_jolts = new SHHJM_Settings(); };
    if !IsDefined(this.m_arnoldArcade_menu) { this.m_arnoldArcade_menu = new RFCModSettings(); };
    if !IsDefined(this.m_arnoldArcade_head) { this.m_arnoldArcade_head = new HIS_Settings(); };
    if !IsDefined(this.m_arnoldArcade_body) { this.m_arnoldArcade_body = new GS_Settings(); };
    if !IsDefined(this.m_arnoldArcade_jolts) { this.m_arnoldArcade_jolts = new SHHJM_Settings(); };
    this.m_realismCustom_menu.splatPresetMode = RFCSplatPresetMode.Realism;
    this.m_realismPlus_menu.splatPresetMode = RFCSplatPresetMode.RealismPlus;
    this.m_dirtyHarry_menu.splatPresetMode = RFCSplatPresetMode.DirtyHarry;
    this.m_arnoldArcade_menu.splatPresetMode = RFCSplatPresetMode.Arnold;
  }

  public func GetBridgeVersion() -> Int32 { return 141; }
  public func GetSessionToken() -> Int32 { return this.m_sessionToken; }
  public func SetSessionToken(value: Int32) -> Void { this.m_sessionToken = value; }
  public func ResetAll() -> Void {
    this.m_global_menu = new RFCModSettings();
    this.m_global_head = new HIS_Settings();
    this.m_global_body = new GS_Settings();
    this.m_global_jolts = new SHHJM_Settings();
    this.m_realismCustom_menu = new RFCModSettings();
    this.m_realismCustom_head = new HIS_Settings();
    this.m_realismCustom_body = new GS_Settings();
    this.m_realismCustom_jolts = new SHHJM_Settings();
    this.m_realismPlus_menu = new RFCModSettings();
    this.m_realismPlus_head = new HIS_Settings();
    this.m_realismPlus_body = new GS_Settings();
    this.m_realismPlus_jolts = new SHHJM_Settings();
    this.m_dirtyHarry_menu = new RFCModSettings();
    this.m_dirtyHarry_head = new HIS_Settings();
    this.m_dirtyHarry_body = new GS_Settings();
    this.m_dirtyHarry_jolts = new SHHJM_Settings();
    this.m_arnoldArcade_menu = new RFCModSettings();
    this.m_arnoldArcade_head = new HIS_Settings();
    this.m_arnoldArcade_body = new GS_Settings();
    this.m_arnoldArcade_jolts = new SHHJM_Settings();
    this.Ensure();
  }

  private func TargetRFC(scopeName: CName) -> ref<RFCModSettings> {
    this.Ensure();
    if Equals(scopeName, n"global") { return this.m_global_menu; };
    if Equals(scopeName, n"realismCustom") { return this.m_realismCustom_menu; };
    if Equals(scopeName, n"realismPlus") { return this.m_realismPlus_menu; };
    if Equals(scopeName, n"dirtyHarry") { return this.m_dirtyHarry_menu; };
    if Equals(scopeName, n"arnoldArcade") { return this.m_arnoldArcade_menu; };
    return this.m_realismCustom_menu;
  }

  private func TargetHIS(scopeName: CName) -> ref<HIS_Settings> {
    this.Ensure();
    if Equals(scopeName, n"global") { return this.m_global_head; };
    if Equals(scopeName, n"realismCustom") { return this.m_realismCustom_head; };
    if Equals(scopeName, n"realismPlus") { return this.m_realismPlus_head; };
    if Equals(scopeName, n"dirtyHarry") { return this.m_dirtyHarry_head; };
    if Equals(scopeName, n"arnoldArcade") { return this.m_arnoldArcade_head; };
    return this.m_realismCustom_head;
  }

  private func TargetGS(scopeName: CName) -> ref<GS_Settings> {
    this.Ensure();
    if Equals(scopeName, n"global") { return this.m_global_body; };
    if Equals(scopeName, n"realismCustom") { return this.m_realismCustom_body; };
    if Equals(scopeName, n"realismPlus") { return this.m_realismPlus_body; };
    if Equals(scopeName, n"dirtyHarry") { return this.m_dirtyHarry_body; };
    if Equals(scopeName, n"arnoldArcade") { return this.m_arnoldArcade_body; };
    return this.m_realismCustom_body;
  }

  private func TargetSHHJM(scopeName: CName) -> ref<SHHJM_Settings> {
    this.Ensure();
    if Equals(scopeName, n"global") { return this.m_global_jolts; };
    if Equals(scopeName, n"realismCustom") { return this.m_realismCustom_jolts; };
    if Equals(scopeName, n"realismPlus") { return this.m_realismPlus_jolts; };
    if Equals(scopeName, n"dirtyHarry") { return this.m_dirtyHarry_jolts; };
    if Equals(scopeName, n"arnoldArcade") { return this.m_arnoldArcade_jolts; };
    return this.m_realismCustom_jolts;
  }

  private func ActiveModeIndex() -> Int32 {
    let value: Int32;
    this.Ensure();
    value = EnumInt(this.m_global_menu.splatPresetMode);
    if value == EnumInt(RFCSplatPresetMode.RealismPlus) { return 2; };
    if value == EnumInt(RFCSplatPresetMode.DirtyHarry) { return 3; };
    if value == EnumInt(RFCSplatPresetMode.Arnold) { return 4; };
    return 1;
  }

  private func ActiveRFC() -> ref<RFCModSettings> {
    let index: Int32 = this.ActiveModeIndex();
    if index == 1 { return this.m_realismCustom_menu; };
    if index == 2 { return this.m_realismPlus_menu; };
    if index == 3 { return this.m_dirtyHarry_menu; };
    return this.m_arnoldArcade_menu;
  }

  private func ActiveHIS() -> ref<HIS_Settings> {
    let index: Int32 = this.ActiveModeIndex();
    if index == 1 { return this.m_realismCustom_head; };
    if index == 2 { return this.m_realismPlus_head; };
    if index == 3 { return this.m_dirtyHarry_head; };
    return this.m_arnoldArcade_head;
  }

  private func ActiveGS() -> ref<GS_Settings> {
    let index: Int32 = this.ActiveModeIndex();
    if index == 1 { return this.m_realismCustom_body; };
    if index == 2 { return this.m_realismPlus_body; };
    if index == 3 { return this.m_dirtyHarry_body; };
    return this.m_arnoldArcade_body;
  }

  private func ActiveSHHJM() -> ref<SHHJM_Settings> {
    let index: Int32 = this.ActiveModeIndex();
    if index == 1 { return this.m_realismCustom_jolts; };
    if index == 2 { return this.m_realismPlus_jolts; };
    if index == 3 { return this.m_dirtyHarry_jolts; };
    return this.m_arnoldArcade_jolts;
  }

  private func MarkRuntimeRead() -> Void {
    if this.m_runtimeReadCount < 2000000000 { this.m_runtimeReadCount += 1; };
  }

  public func GetRuntimeReadCount() -> Int32 {
    return this.m_runtimeReadCount;
  }

  public func Menu() -> ref<RFCModSettings> {
    this.MarkRuntimeRead();
    let out: ref<RFCModSettings> = this.ActiveRFC();
    out.splatPresetMode = this.m_global_menu.splatPresetMode;
    out.masterDeathChanceEnabled = this.m_global_menu.masterDeathChanceEnabled;
    out.masterDeathChancePct = this.m_global_menu.masterDeathChancePct;
    out.disableAllImpulsesDuringTimeDilation = this.m_global_menu.disableAllImpulsesDuringTimeDilation;
    out.killImpulsesEverywhere = this.m_global_menu.killImpulsesEverywhere;
    out.skipDeathAnim = this.m_global_menu.skipDeathAnim;
    out.killMotorcycleDeathAnim = this.m_global_menu.killMotorcycleDeathAnim;
    out.arnold_vehicleMotorcycleToppleOnBullet = this.m_global_menu.arnold_vehicleMotorcycleToppleOnBullet;
    out.arnold_vehicleMotorcycleToppleStrength = this.m_global_menu.arnold_vehicleMotorcycleToppleStrength;
    out.arnold_playerMotorcycleLeanToppleEnabled = this.m_global_menu.arnold_playerMotorcycleLeanToppleEnabled;
    out.arnold_playerMotorcycleLeanToppleAngle = this.m_global_menu.arnold_playerMotorcycleLeanToppleAngle;
    out.arnold_playerMotorcycleLeanToppleMaxSpeed = this.m_global_menu.arnold_playerMotorcycleLeanToppleMaxSpeed;
    out.deathAnimChancePct = this.m_global_menu.deathAnimChancePct;
    out.animCompatDelay = this.m_global_menu.animCompatDelay;
    out.respectCinematics = this.m_global_menu.respectCinematics;
    out.stealthRagdollsEnabled = this.m_global_menu.stealthRagdollsEnabled;
    out.stealthRagdollDelay = this.m_global_menu.stealthRagdollDelay;
    out.blackwallCountsAsStealth = this.m_global_menu.blackwallCountsAsStealth;
    out.arcadeIncapRagdollEnabled = this.m_global_menu.arcadeIncapRagdollEnabled;
    out.arcadeIncapRagdollDelay = this.m_global_menu.arcadeIncapRagdollDelay;
    out.hitReactionsDisabled = this.m_global_menu.hitReactionsDisabled;
    out.injuryShockEnabled = this.m_global_menu.injuryShockEnabled;
    out.injuryShockAllowBosses = this.m_global_menu.injuryShockAllowBosses;
    out.injuryShockAllowSubBosses = this.m_global_menu.injuryShockAllowSubBosses;
    out.injuryShockAllowNPCSources = this.m_global_menu.injuryShockAllowNPCSources;
    out.injuryShockChancePct = this.m_global_menu.injuryShockChancePct;
    out.injuryShockDelay = this.m_global_menu.injuryShockDelay;
    out.injuryShockRandomDelay = this.m_global_menu.injuryShockRandomDelay;
    out.injuryShockGetUpDelay = this.m_global_menu.injuryShockGetUpDelay;
    out.injuryShockGetUpRandomDelay = this.m_global_menu.injuryShockGetUpRandomDelay;
    out.injuryShockLimbsOnly = this.m_global_menu.injuryShockLimbsOnly;
    out.enabled = this.m_global_menu.enabled;
    out.intervalSec = this.m_global_menu.intervalSec;
    out.stickyNearbyRadiusM = this.m_global_menu.stickyNearbyRadiusM;
    out.movingIntoDot = this.m_global_menu.movingIntoDot;
    out.settleTimeSec = this.m_global_menu.settleTimeSec;
    out.sideXY = this.m_global_menu.sideXY;
    out.liftZ = this.m_global_menu.liftZ;
    out.radius = this.m_global_menu.radius;
    out.impactPauseSec = this.m_global_menu.impactPauseSec;
    out.cooldownSec = this.m_global_menu.cooldownSec;
    out.contactDistM = this.m_global_menu.contactDistM;
    out.minSpeedMps = this.m_global_menu.minSpeedMps;
    out.pushXY = this.m_global_menu.pushXY;
    out.downZ = this.m_global_menu.downZ;
    return out;
  }
  public func Head() -> ref<HIS_Settings> {
    this.MarkRuntimeRead();
    let source: ref<HIS_Settings> = this.ActiveHIS();
    let out: ref<HIS_Settings> = new HIS_Settings();
    out.showHeadForwardSection = source.showHeadForwardSection;
    out.showReboundForwardSection = source.showReboundForwardSection;
    out.showHeadBackSection = source.showHeadBackSection;
    out.enabled = source.enabled;
    out.hideFallBack = source.hideFallBack;
    out.forceRagdollFirst = source.forceRagdollFirst;
    out.backForceRagdollFirst = source.backForceRagdollFirst;
    out.onDeath = source.onDeath;
    out.onGroundImpact = source.onGroundImpact;
    out.disableOnGround = source.disableOnGround;
    out.disableOnGroundDelay = source.disableOnGroundDelay;
    out.headKillOnDeathDelay = source.headKillOnDeathDelay;
    out.directionMin = source.directionMin;
    out.forwardBackMin = source.forwardBackMin;
    out.forwardBackMax = source.forwardBackMax;
    out.leftRightMin = source.leftRightMin;
    out.leftRightMax = source.leftRightMax;
    out.upDownMin = source.upDownMin;
    out.upDownMax = source.upDownMax;
    out.chancePct = source.chancePct;
    out.radius = source.radius;
    out.headTargetOffset = source.headTargetOffset;
    out.delaySec = source.delaySec;
    out.steps = source.steps;
    out.stepDelay = source.stepDelay;
    out.rampMode = source.rampMode;
    out.enableRebound = source.enableRebound;
    out.reboundRequiresHeadImpulse = source.reboundRequiresHeadImpulse;
    out.reboundOnImpact = source.reboundOnImpact;
    out.reboundUseNeckFoldGate = source.reboundUseNeckFoldGate;
    out.reboundNeckFoldMin = source.reboundNeckFoldMin;
    out.reboundNeckDropMin = source.reboundNeckDropMin;
    out.reboundKneeNearPct = source.reboundKneeNearPct;
    out.reboundDisableOnGround = source.reboundDisableOnGround;
    out.reboundDisableOnGroundDelay = source.reboundDisableOnGroundDelay;
    out.reboundKillOnDeathDelay = source.reboundKillOnDeathDelay;
    out.reboundForwardMin = source.reboundForwardMin;
    out.reboundDirectionMin = source.reboundDirectionMin;
    out.reboundForwardMax = source.reboundForwardMax;
    out.reboundSideMin = source.reboundSideMin;
    out.reboundSideMax = source.reboundSideMax;
    out.reboundUpMin = source.reboundUpMin;
    out.reboundUpMax = source.reboundUpMax;
    out.reboundChancePct = source.reboundChancePct;
    out.reboundRadius = source.reboundRadius;
    out.reboundDelay = source.reboundDelay;
    out.reboundSteps = source.reboundSteps;
    out.reboundStepDelay = source.reboundStepDelay;
    out.reboundRampMode = source.reboundRampMode;
    out.backEnabled = source.backEnabled;
    out.backOnDeath = source.backOnDeath;
    out.backOnGroundImpact = source.backOnGroundImpact;
    out.backDisableOnGround = source.backDisableOnGround;
    out.backDisableOnGroundDelay = source.backDisableOnGroundDelay;
    out.backKillOnDeathDelay = source.backKillOnDeathDelay;
    out.backDirectionMin = source.backDirectionMin;
    out.backForwardBackMin = source.backForwardBackMin;
    out.backForwardBackMax = source.backForwardBackMax;
    out.backLeftRightMin = source.backLeftRightMin;
    out.backLeftRightMax = source.backLeftRightMax;
    out.backUpDownMin = source.backUpDownMin;
    out.backUpDownMax = source.backUpDownMax;
    out.backChancePct = source.backChancePct;
    out.backRadius = source.backRadius;
    out.backDelaySec = source.backDelaySec;
    out.backSteps = source.backSteps;
    out.backStepDelay = source.backStepDelay;
    out.backRampMode = source.backRampMode;
    out.enableBackRebound = source.enableBackRebound;
    out.backReboundRequiresHeadImpulse = source.backReboundRequiresHeadImpulse;
    out.backReboundOnImpact = source.backReboundOnImpact;
    out.backReboundDisableOnGround = source.backReboundDisableOnGround;
    out.backReboundDisableOnGroundDelay = source.backReboundDisableOnGroundDelay;
    out.backReboundKillOnDeathDelay = source.backReboundKillOnDeathDelay;
    out.backReboundDirectionMin = source.backReboundDirectionMin;
    out.backReboundForwardMin = source.backReboundForwardMin;
    out.backReboundForwardMax = source.backReboundForwardMax;
    out.backReboundSideMin = source.backReboundSideMin;
    out.backReboundSideMax = source.backReboundSideMax;
    out.backReboundUpMin = source.backReboundUpMin;
    out.backReboundUpMax = source.backReboundUpMax;
    out.backReboundChancePct = source.backReboundChancePct;
    out.backReboundRadius = source.backReboundRadius;
    out.backReboundDelay = source.backReboundDelay;
    out.backReboundSteps = source.backReboundSteps;
    out.backReboundStepDelay = source.backReboundStepDelay;
    out.backReboundRampMode = source.backReboundRampMode;
    out.snapSpeedThreshold = source.snapSpeedThreshold;
