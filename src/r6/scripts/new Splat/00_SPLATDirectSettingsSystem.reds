    return out;
  }
  public func Body() -> ref<GS_Settings> { this.MarkRuntimeRead(); return this.ActiveGS(); }
  public func Jolts() -> ref<SHHJM_Settings> { this.MarkRuntimeRead(); return this.ActiveSHHJM(); }

  private func Set_GS_Bool_0(target: ref<GS_Settings>, name: CName, value: Bool) -> Bool {
    if Equals(name, n"earlyDropEnabled") { target.earlyDropEnabled = value; return true; };
    if Equals(name, n"earlyDropForwardEnabled") { target.earlyDropForwardEnabled = value; return true; };
    if Equals(name, n"earlyDropForwardUseCached") { target.earlyDropForwardUseCached = value; return true; };
    if Equals(name, n"earlyDropForwardUseFacing") { target.earlyDropForwardUseFacing = value; return true; };
    if Equals(name, n"earlyDropUseRamp") { target.earlyDropUseRamp = value; return true; };
    if Equals(name, n"enabled") { target.enabled = value; return true; };
    if Equals(name, n"forwardEnabled") { target.forwardEnabled = value; return true; };
    if Equals(name, n"forwardUseCached") { target.forwardUseCached = value; return true; };
    if Equals(name, n"forwardUseFacing") { target.forwardUseFacing = value; return true; };
    if Equals(name, n"impactEnabled") { target.impactEnabled = value; return true; };
    if Equals(name, n"impactForwardAlso") { target.impactForwardAlso = value; return true; };
    if Equals(name, n"impactForwardUseCached") { target.impactForwardUseCached = value; return true; };
    if Equals(name, n"impactForwardUseFacing") { target.impactForwardUseFacing = value; return true; };
    if Equals(name, n"impactUseRamp") { target.impactUseRamp = value; return true; };
    if Equals(name, n"momentumEnabled") { target.momentumEnabled = value; return true; };
    if Equals(name, n"useChance") { target.useChance = value; return true; };
    return false;
  }
  private func Get_GS_Bool_0(target: ref<GS_Settings>, name: CName) -> Bool {
    if Equals(name, n"earlyDropEnabled") { return target.earlyDropEnabled; };
    if Equals(name, n"earlyDropForwardEnabled") { return target.earlyDropForwardEnabled; };
    if Equals(name, n"earlyDropForwardUseCached") { return target.earlyDropForwardUseCached; };
    if Equals(name, n"earlyDropForwardUseFacing") { return target.earlyDropForwardUseFacing; };
